<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Repo-local sources: deterministic restore regardless of the machine-level config.
       All dependencies are public, so nuget.org is the only source. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
