<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <IsAotCompatible>true</IsAotCompatible>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Version is supplied by CI from the git tag: -p:Version=x.y.z -->
    <Version>0.0.0-local</Version>
    <Authors>Marat Tapkanov</Authors>
    <Copyright>Copyright (c) Marat Tapkanov</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/mtapkanov/Coconut.NetCore.RabbitMQ</PackageProjectUrl>
    <RepositoryUrl>https://github.com/mtapkanov/Coconut.NetCore.RabbitMQ</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>
</Project>
